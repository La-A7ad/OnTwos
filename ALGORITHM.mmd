        L2{"lockedHeldFor >= MaxHoldSeconds ?<br/>:226"}
        L3["<b>_held = boneRotation</b>  :228<br/>VERBATIM COPY — this is the only<br/>assignment in the whole scheduler that<br/>is bit-identical to its input.<br/>DidSnap = true  :229<br/>AdvanceSnapGrid  :230"]
        L4["hold — no write  :231"]
        L5["_windowStart = _sampler.OldestTime  :233<br/><b>return _held</b>  :234"]
