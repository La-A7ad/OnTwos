    end

    U11[/"<b>newestEvaluated = _sampler.Evaluate tEnd</b>  :254<br/><b>THIS CALL IS LORE.</b> It is the only thing that<br/>refits the spline and rebuilds the arc-length LUT<br/>before candidates are read. ArcLengthCandidates<br/>interpolates the LUT directly and never refits, so<br/>without this the candidates were placed against a<br/>LUT up to one extrema interval old — measured<br/>displacement reached 22.4 deg, wider than a<br/>typical tau. The value is reused at :337."/]

    U12{"_framesSinceExtremaScan<br/>>= ExtremaInterval = 10 ?<br/>:257"}
    U13[/"<b>ExtremaDetector.FindForBone</b>  :259<br/>refresh _cachedExtrema<br/>SEE SECTION 6"/]
    U14["_framesSinceExtremaScan++  :262<br/><br/>THROTTLE COST: a turning point is on<br/>average 5 and at worst 10 frames old<br/>before it can be a candidate.<br/>TECHNICAL.md 11"]

    U15["<b>BUILD SEGMENT BOUNDARIES</b>  :269-278<br/>_boundaries.Clear<br/>Add tStart<br/>for each cached extremum e:<br/>&nbsp;&nbsp;if tStart &lt; e &lt; tEnd -> Add e<br/>if last &lt; tEnd -> Add tEnd<br/><br/>the window filter is load-bearing: an<br/>extremum predating tStart would produce<br/>unsorted out-of-range boundaries and<br/>corrupt candidate placement"]

    U16["<b>ARC-LENGTH CANDIDATES PER SEGMENT</b>  :281-291<br/>_candidates.Clear<br/>for seg in 0 .. count-2:<br/>&nbsp;&nbsp;a = _boundaries[seg], b = _boundaries[seg+1]<br/>&nbsp;&nbsp;if b - a &lt; 1e-5 -> skip degenerate<br/>&nbsp;&nbsp;ArcLengthCandidates a, b, n, _segCandidates<br/>&nbsp;&nbsp;append the written count<br/>SEE SECTION 4"]

    U17["<b>INTERIOR BOUNDARIES ARE CANDIDATES TOO</b>  :305<br/>for i in 1 .. count-2: _candidates.Add _boundaries[i]<br/><br/>arc-length placement is STRICTLY INTERIOR —<br/>the i+1 / n+1 parameterisation never reaches<br/>either end — so without this the walk could snap<br/>just before a turning point or just after it, but<br/>never ON it. The extremes are exactly where an<br/>animator spends a drawing.<br/><br/>index 0 is tStart and the last is tEnd. Neither is<br/>added: tEnd is already reachable via forceSnap,<br/>tStart is an artefact of where the buffer begins."]

    U18["_candidates.Sort  :307"]
    U19["<b>DEDUPLICATE IN PLACE</b>  :313-323<br/>keep = 0<br/>for read in 0 .. count-1:<br/>&nbsp;&nbsp;if keep &gt; 0 and c[read] - c[keep-1] &lt; 0.016 -> skip<br/>&nbsp;&nbsp;c[keep++] = c[read]<br/>RemoveRange keep, count - keep<br/><br/>0.016 s is ~1 frame at 60 Hz, matching<br/>ExtremaDetector.MinSegment. Compaction writes<br/>over the existing backing array and RemoveRange<br/>only moves elements, so this allocates NOTHING."]

    U20["<b>CADENCE GATE</b>  :326-328<br/>heldFor   = time - _lastSnapTime<br/>allowSnap = heldFor >= MinHoldSeconds<br/>forceSnap = Max is finite AND heldFor >= Max"]

    U21{"<b>forceSnap ?</b>  :334<br/>TESTED FIRST — deliberately"}

    U22["<b>FORCED SNAP</b>  :337-339<br/>_held = newestEvaluated<br/>DidSnap = true<br/>AdvanceSnapGrid time, heldFor<br/><br/>NOTE this is the CURVE at its newest knot,<br/>NOT a copy of the input. It equals boneRotation<br/>as a ROTATION — 0.000000 deg — but matches it<br/>bitwise only 73 pct of the time, and 26 pct on<br/>hemisphere-inconsistent input, where it is an<br/>exact negation about half the time.<br/>Bit-identity belongs to the LOCKED path only."]

    U23{"else allowSnap ?<br/>:341"}

    U24["<b>THE TAU WALK</b>  :344-359<br/>for each candidate t in order:<br/>&nbsp;&nbsp;if t &gt; time -> break<br/>&nbsp;&nbsp;evaluated = _sampler.Evaluate t<br/>&nbsp;&nbsp;if Quaternion.Angle _held, evaluated &gt; Tau:<br/>&nbsp;&nbsp;&nbsp;&nbsp;_held = evaluated<br/>&nbsp;&nbsp;&nbsp;&nbsp;DidSnap = true<br/>&nbsp;&nbsp;&nbsp;&nbsp;_lastSnapTime = t   &lt;- the CANDIDATE's time,<br/>&nbsp;&nbsp;&nbsp;&nbsp;not 'time': the snap conceptually happened<br/>&nbsp;&nbsp;&nbsp;&nbsp;at t, so the next MinHold window is measured<br/>&nbsp;&nbsp;&nbsp;&nbsp;from the real event."]

    U25["<b>CHAINS DELIBERATELY.</b> The walk does not stop<br/>at the first crossing — it keeps going and keeps<br/>the LAST qualifying candidate, so the held pose<br/>reflects the newest step position rather than<br/>lagging behind it.<br/><br/>KNOWN COST: an extremum the walk lands on is<br/>overwritten whenever a later candidate also<br/>qualifies. That is why making extrema eligible<br/>helped some configurations and not others.<br/>An aesthetic trade, not a defect. TECHNICAL.md 11"]

    U26["hold — MinHoldSeconds not yet elapsed,<br/>return _held untouched  :360"]

    U27["_windowStart = _sampler.OldestTime  :364<br/>advance the window; drop the oldest portion"]
    U28(["<b>return _held</b>  :366"])

